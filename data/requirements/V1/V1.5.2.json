  "summaries": [
    {
      "id": "sum-385d0c",
      "kind": "origin",
      "body": "V1.5.2 is the surviving deserialization-safety control. It merges v4 V5.5.3 (protect deserialization of untrusted data) with v4 V1.5.2 (do not serialize to untrusted clients). elarlang flagged the pair as duplicates in #1084; jmanico merged them in October 2021, dropping integrity stamps as a defence because they do not fix a vulnerable deserializer (#772).",
      "citations": [
        {
          "type": "issue_body",
          "url": "https://github.com/OWASP/ASVS/issues/1084",
          "issue": 1084
        },

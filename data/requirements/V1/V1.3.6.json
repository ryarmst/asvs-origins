  "summaries": [
    {
      "id": "sum-d4498d",
      "kind": "origin",
      "body": "SSRF entered ASVS in August 2018 when jmanico added V5.30 as a one-line control with no defensive guidance. Over the next few months vanderaj and tghosth relocated it during v4.0 development — first to V5.4.2, then to V5.1.9 — and the January 2019 move introduced allowlisting of protocols, domains, paths and ports, which has remained the core of the requirement ever since. It settled as V5.2.6 in v4.0.3.",
      "citations": [
        {
          "type": "commit",
          "url": "https://github.com/OWASP/ASVS/commit/3b6b57a0",
          "commit": "3b6b57a0"
        },

  "summaries": [
    {
      "id": "sum-21d173",
      "kind": "origin",
      "body": "V1.3.8 is new in v5.0.0. ImanSharaf opened #1533 in January 2023 noting that ASVS covered SQL, LDAP and SMTP injection but not JNDI. jmanico called it a Log4Shell-shaped gap and argued the defence is allowlisting JNDI names plus least privilege on the context, not encoding. tghosth committed 5.2.11 in September 2023.",
      "citations": [
        {
          "type": "issue_body",
          "url": "https://github.com/OWASP/ASVS/issues/1533",
          "issue": 1533
        },

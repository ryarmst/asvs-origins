{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asvs-origins.local/schema/requirement.schema.json",
  "title": "ASVS Origins requirement record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uid",
    "slug",
    "current",
    "master",
    "identifiers",
    "lineage",
    "summaries",
    "decisions",
    "open_questions",
    "terminology",
    "key_sources",
    "related_requirements",
    "external_references",
    "status"
  ],
  "properties": {
    "uid": {
      "type": "string",
      "pattern": "^req-[0-9a-f]{8}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "id",
        "chapter_id",
        "chapter_name",
        "section_id",
        "section_name",
        "level",
        "text",
        "source",
        "status"
      ],
      "properties": {
        "release": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "pattern": "^V[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "chapter_id": { "type": "string", "pattern": "^V[0-9]+$" },
        "chapter_name": { "type": "string", "minLength": 1 },
        "section_id": { "type": "string", "pattern": "^V[0-9]+\\.[0-9]+$" },
        "section_name": { "type": "string", "minLength": 1 },
        "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 },
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["current", "deleted"] }
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "text", "differs_from_release", "checked_at"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 },
        "text": { "type": ["string", "null"] },
        "differs_from_release": { "type": "boolean" },
        "checked_at": { "$ref": "common.schema.json#/$defs/isoDate" }
      }
    },
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["release", "id", "level", "status"],
        "properties": {
          "release": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 },
          "status": {
            "type": "string",
            "enum": ["current", "predecessor", "historical", "deleted"]
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_kind",
        "predecessors",
        "mapping_entry",
        "events",
        "provenance"
      ],
      "properties": {
        "origin_kind": {
          "type": "string",
          "enum": [
            "new_in_release",
            "carried_forward",
            "split_from",
            "merged_from",
            "unknown"
          ]
        },
        "predecessors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["release", "id", "relation", "text", "note"],
            "properties": {
              "release": { "type": "string", "minLength": 1 },
              "id": { "type": "string", "minLength": 1 },
              "relation": {
                "type": "string",
                "enum": [
                  "modified",
                  "moved",
                  "split",
                  "merged",
                  "grammar",
                  "level_change",
                  "replaced_slot",
                  "conceptual"
                ]
              },
              "text": { "type": ["string", "null"] },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "mapping_entry": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["raw", "status", "agrees_with_git", "note"],
              "properties": {
                "raw": { "type": "string" },
                "status": { "type": "string" },
                "agrees_with_git": { "type": "boolean" },
                "note": { "type": ["string", "null"] }
              }
            },
            { "type": "null" }
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "kind",
              "commit",
              "actor",
              "id_at_time",
              "summary",
              "citations"
            ],
            "properties": {
              "date": { "$ref": "common.schema.json#/$defs/isoDate" },
              "kind": {
                "type": "string",
                "enum": [
                  "added",
                  "removed",
                  "reworded",
                  "moved",
                  "split",
                  "merged",
                  "level_changed",
                  "renumbered",
                  "grammar",
                  "tag_cleanup"
                ]
              },
              "commit": { "type": ["string", "null"] },
              "actor": { "type": ["string", "null"] },
              "id_at_time": { "type": ["string", "null"] },
              "summary": { "type": "string", "minLength": 1 },
              "citations": {
                "type": "array",
                "items": { "$ref": "common.schema.json#/$defs/Citation" }
              }
            }
          }
        },
        "provenance": { "$ref": "common.schema.json#/$defs/Provenance" }
      }
    },
    "summaries": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Summary" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Claim" }
    },
    "open_questions": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Claim" }
    },
    "terminology": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Claim" }
    },
    "key_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "number", "role", "rank"],
        "properties": {
          "kind": { "type": "string", "enum": ["issue", "pr"] },
          "number": { "type": "integer", "minimum": 1 },
          "role": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "related_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uid", "id", "relation", "note"],
        "properties": {
          "uid": { "type": "string", "pattern": "^req-[0-9a-f]{8}$" },
          "id": { "type": "string", "minLength": 1 },
          "relation": {
            "type": "string",
            "enum": [
              "boundary",
              "overlaps",
              "supersedes",
              "superseded_by",
              "depends_on",
              "duplicate_candidate",
              "companion"
            ]
          },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "external_references": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/ExternalReference" }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "lineage_state",
        "last_pipeline_run",
        "last_human_review",
        "blocked_reason",
        "stale"
      ],
      "properties": {
        "coverage": { "$ref": "common.schema.json#/$defs/CoverageStatus" },
        "lineage_state": {
          "type": "string",
          "enum": ["empty", "partial", "complete", "disputed"]
        },
        "last_pipeline_run": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/isoDateTime" },
            { "type": "null" }
          ]
        },
        "last_human_review": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/isoDateTime" },
            { "type": "null" }
          ]
        },
        "blocked_reason": { "type": ["string", "null"] },
        "stale": { "type": "boolean" }
      }
    }
  }
}
